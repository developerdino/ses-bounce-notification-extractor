# Azure AD Application Configuration
# Get these values from your Azure AD App Registration:
# https://portal.azure.com -> Microsoft Entra ID -> App registrations

# Application (client) ID from Azure AD App Registration
AZURE_CLIENT_ID=your-client-id-here

# Directory (tenant) ID from Azure AD App Registration
AZURE_TENANT_ID=your-tenant-id-here

# Mail folder name where bounce notifications are stored
# Default: "SES Bounces"
MAIL_FOLDER_NAME=SES Bounces
